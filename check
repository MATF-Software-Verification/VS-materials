#!/bin/sh
set -e

echo "=== 1/3 quarto check ==="
quarto check >/dev/null
echo "  ok"

echo "=== 2/3 residual LaTeX in .qmd (must be empty) ==="
out=$(rg -g '*.qmd' -e 'subimport' -e 'codefile' -e 'begin\{' -e 'tightlist' . || true)
if [ -n "$out" ]; then
  echo "  FAIL: residual LaTeX found:"
  printf '%s\n' "$out"
  exit 1
fi
echo "  ok (clean)"

echo "=== 3/3 image files exist ==="
python3 - <<'PY'
import os, re, sys
skip = {'build', '_book', '.git', '_minted', 'node_modules'}
img_re = re.compile(r'!\[\w*\]\(([^)]+)\)')
missing = []
img_n = 0
for dp, _, fs in os.walk('.'):
    if any(p in skip for p in dp.split(os.sep)):
        continue
    for fn in fs:
        if not fn.endswith('.qmd'):
            continue
        p = os.path.join(dp, fn)
        try:
            txt = open(p, encoding='utf-8', errors='replace').read()
        except Exception:
            continue
        d = os.path.dirname(p)
        for m in img_re.finditer(txt):
            u = m.group(1)
            if u.startswith(('http://', 'https://', 'data:')):
                continue
            img_n += 1
            if not os.path.exists(os.path.join(d, u)):
                missing.append(('image', u, os.path.relpath(p)))
print(f"  image paths: {img_n}")
if missing:
    print("  FAIL: missing files:")
    for k, path, src in missing:
        print(f"    [{k}] {path}  (from {src})")
    sys.exit(1)
print("  all exist")
PY

echo "=== check passed ==="
